{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FPSMaster Launcher",
  "version": "0.2.1",
  "identifier": "com.fpsmaster.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "npm run prepare:java-core",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FPSMaster Launcher",
        "width": 1120,
        "height": 760,
        "resizable": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/java/java-core.jar"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
