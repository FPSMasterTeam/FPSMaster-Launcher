{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FPSMaster Launcher",
  "version": "0.1.0",
  "identifier": "com.fpsmaster.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FPSMaster Launcher",
        "width": 1120,
        "height": 760,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": []
  }
}
