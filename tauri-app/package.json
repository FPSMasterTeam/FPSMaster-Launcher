{
  "name": "fpsmaster-launcher-ui",
  "private": true,
  "version": "0.3.14",
  "type": "module",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "predev": "npm run version:sync",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run version:sync",
    "build": "vite build",
    "prebuild:installer": "npm run version:sync",
    "build:installer": "npx tauri build --bundles nsis --ci --no-sign",
    "build:installer:windows": "npx tauri build --bundles nsis --ci --no-sign",
    "build:installer:windows:win7": "npx tauri build --bundles nsis --ci --no-sign --config src-tauri/win7.config.json",
    "build:installer:linux": "npx tauri build --bundles deb --ci --no-sign",
    "build:installer:macos": "npx tauri build --target aarch64-apple-darwin --bundles dmg --ci --no-sign",
    "preview": "vite preview",
    "pretauri": "npm run version:sync",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-select": "^2.2.6",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-shell": "^2.0.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.2.0"
  }
}
